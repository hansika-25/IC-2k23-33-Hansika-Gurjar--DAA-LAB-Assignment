             ┌─────────┐
             │  START  │
             └────┬────┘
                  ↓
          ┌─────────────────┐
          │ Input array A   │
          └────────┬────────┘
                   ↓
             ┌───────────┐
             │  i = 0    │
             └─────┬─────┘
                   ↓
             ┌───────────┐
             │  i < n-1? │
             └───┬───┬───┘
                Yes  No
                 ↓    ↓
          ┌──────────┐  ┌─────────────┐
          │  j = 0   │  │ Print array │
          └────┬─────┘  └──────┬──────┘
               ↓               ↓
          ┌───────────┐    ┌─────────┐
          │ j < n-i-1?│    │   END   │
          └───┬───┬───┘    └─────────┘
             Yes  No
              ↓    ↓
       ┌─────────────────┐
       │ A[j] > A[j+1]?  │
       └───┬─────────┬───┘
          Yes        No
           ↓          │
      ┌──────────┐    │
      │  Swap    │    │
      │ elements │    │
      └────┬─────┘    │
           └──────┬───┘
                  ↓
              j = j + 1
                  │
                  └──────→ back to
                           j < n-i-1?